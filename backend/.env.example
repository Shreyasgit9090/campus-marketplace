# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_marketplace

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# College domain restriction
COLLEGE_EMAIL_DOMAIN=msrit.edu

# OTP
OTP_EXPIRY_MINUTES=10

# Email (used to send OTPs) — e.g. an app password for Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Marketplace <no-reply@campusmarketplace.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
