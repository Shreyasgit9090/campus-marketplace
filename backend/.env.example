# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuscart

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# College domain restriction
COLLEGE_EMAIL_DOMAIN=msrit.edu

# OTP
OTP_EXPIRY_MINUTES=10

# Email (used to send OTPs). Leave SMTP_USER/SMTP_PASSWORD blank to fall back
# to logging the OTP to the console instead of sending — useful for local dev.
#
# To send for real via Gmail:
#   SMTP_USER     = your full Gmail address, e.g. you@gmail.com
#   SMTP_PASSWORD = a 16-character Gmail APP PASSWORD, not your login password.
#                   Generate one at: Google Account -> Security ->
#                   2-Step Verification (must be on) -> App passwords.
#   SMTP_FROM     = should match SMTP_USER's address (Gmail rewrites/rejects
#                   a From address that doesn't belong to the authenticated
#                   account), e.g. "CampusCart <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusCart <you@gmail.com>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
